fn add_ints(a: i32, b: i32) -> i32 {
    return a + b;
}

fn do_nothing() {
    let x: i32 = 0;
}

fn compute_factorial(n: i32) -> i32 {
    let result: i32 = 1;
    let i: i32 = 1;
    
    while (i <= n) {
        result = result * i;
        i = i + 1;
    }
    
    return result;
}

